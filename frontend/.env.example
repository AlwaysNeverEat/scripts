# Backend URL (no trailing slash). Leave empty to use the Vite dev proxy.
VITE_API_BASE=https://your-backend.railway.app

# Запасные адреса бэкенда через запятую — на случай, если основное имя режут.
# Обычно пусто: имя api.<домен сайта> клиент пробует и без настройки.
VITE_API_FALLBACKS=

# Must match API_KEY in backend/.env
VITE_API_KEY=change-me
