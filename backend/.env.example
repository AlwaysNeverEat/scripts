# PostgreSQL connection string (Supabase: Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Single shared secret — put this in the x-api-key header on every request
API_KEY=change-me-to-a-long-random-string

# Origins allowed to call the API (comma-separated, no trailing slash)
# Add your Vercel frontend URL here after deploy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

PORT=3001

# ── Аутентификация и Telegram-админка ──────────────────────────────────────────

# Токен Telegram-бота (@BotFather → /newbot). Пусто — бот выключен, сайт
# работает без регистрации через Telegram (заявки просто копятся в БД).
TELEGRAM_BOT_TOKEN=

# Telegram user id, который получает заявки на регистрацию по умолчанию
# (сидируется в таблицу bot_admins при первом старте бота, если она пуста).
# Узнать свой id: написать боту @userinfobot.
ADMIN_TELEGRAM_ID=691442300

# ── Supabase Storage (аватарки) ─────────────────────────────────────────────────
# Project Settings → API. Нужен именно service_role ключ (не anon) — он один
# пишет в приватный по умолчанию бакет 'avatars', который должен быть public
# на чтение (см. DEPLOY.md, шаг про Storage).
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=change-me
