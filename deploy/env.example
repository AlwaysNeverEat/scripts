# Скопировать в deploy/.env и заполнить. Файл НЕ коммитить (он в .gitignore).
# Все значения — на своём сервере, наружу не уходят.

# ── Обязательное ─────────────────────────────────────────────────────────────

# Пароль локального Postgres. Наружу порт закрыт, так что важна только длина.
# Сгенерировать:  openssl rand -hex 24
# (именно -hex, а не -base64: спецсимволы тут работают — пароль передаётся
# отдельной переменной, а не внутри URL, — но hex не создаёт проблем ещё и при
# копировании через шелл и подстановке в compose.)
POSTGRES_PASSWORD=

# Общий ключ API — тот же, что вшит в сборку сайта и в юзерскрипты.
# ВАЖНО: возьми ТОТ ЖЕ, что стоит сейчас на Render, иначе после переезда
# перестанут работать уже установленные у людей юзерскрипты.
API_KEY=

# Ключ шифрования пароля CRM. Тоже перенести с Render КАК ЕСТЬ: со сменой
# ключа все привязки учёток CRM перестанут расшифровываться и сотрутся,
# работники будут входить в CRM заново.
CRM_LINK_SECRET=

# Origin'ы, которым разрешён доступ. Сайт теперь на одном домене с API, но
# юзерскрипты в Tampermonkey ходят сюда со страниц каталогов.
CORS_ORIGINS=https://k-spot.ru,https://www.k-spot.ru

# ── Telegram ─────────────────────────────────────────────────────────────────
# Пусто = бот выключен, заявки на регистрацию будут копиться в БД молча.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=691442300

# ── Не задавать на своём сервере ─────────────────────────────────────────────
# SUPABASE_URL / SUPABASE_SERVICE_KEY больше не нужны: аватарки уходят на
# локальный диск (AVATAR_DIR прописан в docker-compose.prod.yml).
