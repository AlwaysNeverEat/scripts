# Скопировать в deploy/.env и заполнить. Файл НЕ коммитить (он в .gitignore).
# Все значения — на своём сервере, наружу не уходят.

# ── Обязательное ─────────────────────────────────────────────────────────────

# Пароль локального Postgres. Наружу порт закрыт, так что важна только длина.
# Сгенерировать:  openssl rand -hex 24
# (именно -hex, а не -base64: спецсимволы тут работают — пароль передаётся
# отдельной переменной, а не внутри URL, — но hex не создаёт проблем ещё и при
# копировании через шелл и подстановке в compose.)
POSTGRES_PASSWORD=

# Общий ключ API — тот же, что вшит в сборку сайта и в юзерскрипты.
# ВАЖНО: возьми ТОТ ЖЕ, что стоит сейчас на Render, иначе после переезда
# перестанут работать уже установленные у людей юзерскрипты.
API_KEY=

# Ключ шифрования пароля CRM. Тоже перенести с Render КАК ЕСТЬ: со сменой
# ключа все привязки учёток CRM перестанут расшифровываться и сотрутся,
# работники будут входить в CRM заново.
CRM_LINK_SECRET=

# Origin'ы, которым разрешён доступ. Сайт теперь на одном домене с API, но
# юзерскрипты в Tampermonkey ходят сюда со страниц каталогов.
CORS_ORIGINS=https://k-spot.ru,https://www.k-spot.ru

# ── Сертификат CRM ───────────────────────────────────────────────────────────
# Нужно ТОЛЬКО если панель «Наличие на станции» пишет «CRM недоступна … Это
# сертификат самой CRM». Так бывает, когда сертификат CRM просрочен или
# самоподписан: браузер работника пускает после «всё равно перейти», а сервер
# рвёт соединение и панель мертва.
#
# Правильное лечение — обновить сертификат на стороне CRM. Пока его чинят,
# посмотри, что там сейчас, и вставь отпечаток сюда:
#
#   node backend/scripts/crm-tls-info.js
#
# С отпечатком цепочка не проверяется, зато проверяется сам сертификат: чужой
# сервер вместо CRM пароли работников не получит. Отпечаток меняется при каждом
# перевыпуске — после починки строку лучше убрать совсем.
CRM_TLS_FINGERPRINT=

# Если CRM живёт на своём удостоверяющем центре, а сертификат не просрочен —
# достаточно положить корневой сертификат файлом и указать путь.
CRM_TLS_CA_FILE=

# Крайнее средство: не проверять сертификат CRM вообще. Отличается от строки
# выше тем, что подменить CRM сможет кто угодно в сети между сервером и CRM,
# а пароли работников идут туда же. Ставь, только если отпечаток снять неоткуда.
CRM_TLS_INSECURE=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Пусто = бот выключен, заявки на регистрацию будут копиться в БД молча.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=691442300

# С российского хостинга api.telegram.org НЕ ОТКРЫВАЕТСЯ — соединение не
# устанавливается вовсе (ConnectTimeoutError на 443), хотя остальной интернет
# с той же машины работает. Проверить: curl -m 10 https://api.telegram.org
#
# Пока эта строка пуста, бот молчит: заявки на регистрацию копятся в БД, и
# одобрять их приходится вручную (см. DEPLOY-VPS.md).
#
# Чтобы починить — поставь сюда адрес зеркала, которое до Telegram дотягивается.
# Дешевле всего Cloudflare Worker в три строки, но подойдёт и любой VPS за
# рубежом с nginx, и self-hosted telegram-bot-api. Путь и формат те же, меняется
# только хост:  TELEGRAM_API_BASE=https://tg.<твой-домен>.workers.dev
TELEGRAM_API_BASE=

# ── Mapillary (пасхалка «Гео») ───────────────────────────────────────────────
# Пусто = игра выключена и честно об этом говорит; остальной сайт работает.
#
# Mapillary — краудсорсинговый банк уличных снимков (проект Meta). Токен берётся
# бесплатно и БЕЗ БАНКОВСКОЙ КАРТЫ:
#
#   1. регистрация на mapillary.com (можно через Google или Facebook);
#   2. www.mapillary.com/dashboard/developers → Register application;
#   3. в приложении включить право «read» (остальные не нужны);
#   4. скопировать Client Token — он начинается на MLY|.
#
# Проверить прямо с сервера (должен ответить списком снимков в data):
#   curl -s "https://graph.mapillary.com/images?access_token=ТОКЕН\
#     &fields=id&bbox=2.29,48.84,2.31,48.86&limit=3"
#
# Токен ОДИН — он же уезжает в браузер, и это нормально: клиентский токен на то
# и клиентский, снимки в окне игры без него не показать. Секретный ключ
# приложения (Client Secret) сюда класть НЕ НАДО, он тут не нужен вовсе.
#
# Почему не Google Street View: покрытие у него лучше, но любой его API требует
# привязанной к проекту банковской карты — даже бесплатные запросы без биллинга
# отвечают REQUEST_DENIED.
MAPILLARY_TOKEN=

# ── Не задавать на своём сервере ─────────────────────────────────────────────
# SUPABASE_URL / SUPABASE_SERVICE_KEY больше не нужны: аватарки уходят на
# локальный диск (AVATAR_DIR прописан в docker-compose.prod.yml).
